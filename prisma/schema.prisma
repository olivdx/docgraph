generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  telegramUserId String         @unique @map("telegram_user_id")
  displayName    String         @map("display_name")
  avatarUrl      String?        @map("avatar_url")
  rating         Int            @default(1200)
  gamesPlayed    Int            @default(0) @map("games_played")
  wins           Int            @default(0)
  losses         Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  matchesAsX     Match[]        @relation("MatchPlayerX")
  matchesAsO     Match[]        @relation("MatchPlayerO")
  wonMatches     Match[]        @relation("MatchWinner")
  moves          MatchMove[]
  ratingChanges  RatingChange[]

  @@map("users")
}

model Match {
  id         String          @id @default(cuid())
  mode       MatchMode
  status     MatchStatus
  playerXId  String          @map("player_x_id")
  playerOId  String          @map("player_o_id")
  winnerId   String?         @map("winner_id")
  endReason  MatchEndReason? @map("end_reason")
  boardSize  Int             @map("board_size")
  startedAt  DateTime        @default(now()) @map("started_at")
  endedAt    DateTime?       @map("ended_at")
  playerX    User            @relation("MatchPlayerX", fields: [playerXId], references: [id])
  playerO    User            @relation("MatchPlayerO", fields: [playerOId], references: [id])
  winner     User?           @relation("MatchWinner", fields: [winnerId], references: [id])
  moves      MatchMove[]
  ratingChanges RatingChange[]

  @@map("matches")
}

model MatchMove {
  id       String   @id @default(cuid())
  matchId  String   @map("match_id")
  moveNo   Int      @map("move_no")
  playerId String   @map("player_id")
  x        Int
  y        Int
  playedAt DateTime @default(now()) @map("played_at")
  match    Match    @relation(fields: [matchId], references: [id])
  player   User     @relation(fields: [playerId], references: [id])

  @@unique([matchId, moveNo])
  @@map("match_moves")
}

model RatingChange {
  id           String   @id @default(cuid())
  matchId      String   @map("match_id")
  userId       String   @map("user_id")
  ratingBefore Int      @map("rating_before")
  ratingAfter  Int      @map("rating_after")
  delta        Int
  createdAt    DateTime @default(now()) @map("created_at")
  match        Match    @relation(fields: [matchId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@map("rating_changes")
}

enum MatchMode {
  quick
  private
}

enum MatchStatus {
  ongoing
  finished
}

enum MatchEndReason {
  five_in_row
  turn_timeout
  disconnect_timeout
  resign
}
